# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- DeepSeek: LLM giải thích tương tác thuốc - thuốc ----
# Lấy API key tại https://platform.deepseek.com/api_keys rồi dán vào DEEPSEEK_API_KEY trong file .env.
# Để trống thì API /api/v1/interactions/check vẫn chạy, nhưng phần giải thích dùng mẫu soạn sẵn từ CSDL (không gọi LLM).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Nhiệt độ thấp để lời giải thích bám sát dữ liệu nguồn
EXPLAIN_TEMPERATURE=0.2
EXPLAIN_TIMEOUT_S=60
# Kiểm định từng câu giải thích bằng thêm một lượt gọi LLM (chống trả lời ngoài CSDL).
# false = nhanh hơn, chỉ kiểm tra bằng code (đoạn trích, con số, guardrail)
EXPLAIN_VERIFY=true

# ---- Pretranslate interaction evidence into Vietnamese ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Basic: set GOOGLE_TRANSLATION_API_KEY. Advanced glossary: project + glossary,
# and GOOGLE_APPLICATION_CREDENTIALS pointing to a service-account JSON file.
GOOGLE_TRANSLATION_API_KEY=
GOOGLE_TRANSLATION_PROJECT=
GOOGLE_TRANSLATION_LOCATION=us-central1
GOOGLE_TRANSLATION_GLOSSARY=

# ---- Database ----
# Postgres 16 + pgvector chạy bằng `docker compose up -d db`; nạp dữ liệu MVP: `python db/load_mvp.py` (schema `mvp`)
# Dùng 127.0.0.1 thay cho localhost: trên Windows, localhost thử IPv6 trước và mỗi kết nối bị treo ~5 giây
DATABASE_URL=postgresql://ddi:ddi_dev_password@127.0.0.1:5432/ddi
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
